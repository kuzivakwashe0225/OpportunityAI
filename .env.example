# Web search for discovery (search.py). SearXNG (self-hosted, docker-compose.yml)
# is the primary backend and needs no key here - only SEARXNG_SECRET below.
# TAVILY_API_KEY is kept as an optional fallback: set it and unset SEARXNG_URL
# to use Tavily instead, e.g. if you are not running the searxng/valkey
# containers. Tavily's free plan has a hard monthly request cap with no
# overage - confirmed live via its own /usage endpoint - so it is not a
# reliable default any more.
TAVILY_API_KEY=
# Required by the searxng container's own startup check - a real secret, not
# a placeholder. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=
# Rate-limit hygiene for self-hosted search - see searxng/README.md. Both
# have sensible defaults (360 minutes, 1.0 seconds) if left unset here.
SEARCH_CACHE_TTL_MINUTES=360
SEARCH_PAUSE_SECONDS=1.0
OPPORTUNITY_AGENT_STORE_PATH=.data/store.json

# Phase 2 (SOLUTION_DEFINITION.md §14) - accounts, documents, containers.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=
# Local dev default is SQLite (no value needed here); docker-compose sets
# this to the `db` Postgres service automatically - only set it yourself
# for a non-Docker Postgres.
DATABASE_URL=
MINIO_ACCESS_KEY=opportunity
MINIO_SECRET_KEY=opportunity-secret

# --- Serving this over the public internet ---------------------------------
# Both default to on in docker-compose.yml, because the deployment this repo
# describes sits behind Caddy with a real certificate. Turn them off only for
# local development over http://localhost, where a Secure cookie is simply
# never sent and would lock you out of your own machine with no error to read.
#
# SESSION_COOKIE_SECURE - the session cookie is only sent over HTTPS.
# HSTS_ENABLED - browsers refuse to try this hostname over HTTP again. Hard to
# undo: a max-age of a year is a year. Never switch this on for a hostname
# that cannot serve HTTPS.
SESSION_COOKIE_SECURE=1
HSTS_ENABLED=1

# --- Sign in with Google ----------------------------------------------------
# Optional. Leave unset and the sign-in page just shows the button as not
# configured - password sign-in keeps working either way.
#
# To get one: Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Application type "Web application".
# Add this site's origin (e.g. https://opportunityai.meshcloud.co.zw) under
# "Authorized JavaScript origins". No client secret is needed or used - the
# browser proves identity with a signed token this server verifies for
# itself (google_auth.py), never a server-side secret exchange.
GOOGLE_CLIENT_ID=

# --- Admin / beta-test monitoring dashboard --------------------------------
# Comma-separated emails that get /admin/*: who's actually using the system,
# feedback they've sent, and issues (client and server faults) it caught on
# its own. An account is promoted the first time it makes an authenticated
# request after its email appears here - no database edit needed.
ADMIN_EMAILS=
