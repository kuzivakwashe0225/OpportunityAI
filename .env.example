# Web search for discovery (search.py). SearXNG (self-hosted, docker-compose.yml)
# is the primary backend and needs no key here - only SEARXNG_SECRET below.
# TAVILY_API_KEY is kept as an optional fallback: set it and unset SEARXNG_URL
# to use Tavily instead, e.g. if you are not running the searxng/valkey
# containers. Tavily's free plan has a hard monthly request cap with no
# overage - confirmed live via its own /usage endpoint - so it is not a
# reliable default any more.
TAVILY_API_KEY=
# Required by the searxng container's own startup check - a real secret, not
# a placeholder. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=
# Rate-limit hygiene for self-hosted search - see searxng/README.md. Both
# have sensible defaults (360 minutes, 1.0 seconds) if left unset here.
SEARCH_CACHE_TTL_MINUTES=360
SEARCH_PAUSE_SECONDS=1.0
OPPORTUNITY_AGENT_STORE_PATH=.data/store.json

# Phase 2 (SOLUTION_DEFINITION.md §14) - accounts, documents, containers.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=
# Local dev default is SQLite (no value needed here); docker-compose sets
# this to the `db` Postgres service automatically - only set it yourself
# for a non-Docker Postgres.
DATABASE_URL=
MINIO_ACCESS_KEY=opportunity
MINIO_SECRET_KEY=opportunity-secret
