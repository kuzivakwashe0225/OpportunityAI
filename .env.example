TAVILY_API_KEY=
OPPORTUNITY_AGENT_STORE_PATH=.data/store.json

# Phase 2 (SOLUTION_DEFINITION.md §14) - accounts, documents, containers.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
